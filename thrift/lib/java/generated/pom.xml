<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.facebook.fbthrift</groupId>
    <artifactId>fbthrift-java-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>java-generated-core</artifactId>
  <name>FBThrift Java generated core types</name>

  <dependencies>
    <dependency>
      <groupId>com.facebook.fbthrift</groupId>
      <artifactId>common</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>prepare-thrift-output</id>
            <phase>generate-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/generated-sources/thrift"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-core-thrift</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-r</argument>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>java:separate_data_type_from_services</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-sources/thrift</argument>
                <argument>${fbthrift.source.root}/thrift/lib/thrift/RpcMetadata.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-metadata-thrift</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-r</argument>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>java:separate_data_type_from_services</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-sources/thrift</argument>
                <argument>${fbthrift.source.root}/thrift/lib/thrift/metadata.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-any-thrift</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-r</argument>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>java:separate_data_type_from_services</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-sources/thrift</argument>
                <argument>${fbthrift.source.root}/thrift/lib/thrift/any.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-conformance-protocol-thrift</id>
            <phase>generate-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-r</argument>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>java:separate_data_type_from_services</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-sources/thrift</argument>
                <argument>${fbthrift.source.root}/thrift/conformance/if/any.thrift</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-generated-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.build.directory}/generated-sources/thrift/gen-java/data-type</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
