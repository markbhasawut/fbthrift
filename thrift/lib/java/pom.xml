<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.facebook.fbthrift</groupId>
  <artifactId>fbthrift-java-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>FBThrift Java</name>

  <modules>
    <module>common</module>
    <module>generated</module>
    <module>runtime</module>
    <module>test-fixtures</module>
    <module>tests</module>
    <module>../../conformance/java</module>
    <module>benchmarks</module>
    <module>varint</module>
    <module>example/ping</module>
    <module>fbthrift-maven-plugin</module>
    <module>../android_lite</module>
    <module>../javadeprecated</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <maven.compiler.testRelease>21</maven.compiler.testRelease>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <fbthrift.java.version>1.0.0-SNAPSHOT</fbthrift.java.version>
    <fbthrift.compiler>thrift1</fbthrift.compiler>
    <fbthrift.source.root>${maven.multiModuleProjectDirectory}/../../..</fbthrift.source.root>
    <netty.version>4.2.15.Final</netty.version>
    <reactor.version>3.8.6</reactor.version>
    <reactor.netty.version>1.3.6</reactor.netty.version>
    <rsocket.version>1.1.5</rsocket.version>
    <junit.version>5.13.4</junit.version>
    <mockito.version>5.18.0</mockito.version>
    <byte-buddy.version>1.18.7</byte-buddy.version>
    <assertj.version>3.27.4</assertj.version>
    <hamcrest.version>3.0</hamcrest.version>
    <jmh.version>1.37</jmh.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.netty</groupId>
        <artifactId>netty-bom</artifactId>
        <version>${netty.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.facebook.fbthrift</groupId>
        <artifactId>common</artifactId>
        <version>${fbthrift.java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.facebook.fbthrift</groupId>
        <artifactId>java-generated-core</artifactId>
        <version>${fbthrift.java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.facebook.fbthrift</groupId>
        <artifactId>runtime</artifactId>
        <version>${fbthrift.java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.facebook.fbthrift</groupId>
        <artifactId>java-test-fixtures</artifactId>
        <version>${fbthrift.java.version}</version>
      </dependency>
      <dependency>
        <groupId>com.facebook.fbthrift</groupId>
        <artifactId>java-conformance</artifactId>
        <version>${fbthrift.java.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.14.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.3</version>
          <configuration>
            <useModulePath>false</useModulePath>
            <systemPropertyVariables>
              <fbthrift.source.root>${fbthrift.source.root}</fbthrift.source.root>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.4.2</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>require-supported-java</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22),[25,26)</version>
                  <message>FBThrift Java requires JDK 21 or JDK 25.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
