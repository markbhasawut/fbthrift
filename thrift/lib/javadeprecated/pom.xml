<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.facebook.fbthrift</groupId>
    <artifactId>fbthrift-java-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../java/pom.xml</relativePath>
  </parent>

  <artifactId>javadeprecated</artifactId>
  <name>FBThrift deprecated Java runtime</name>

  <dependencies>
    <dependency>
      <groupId>com.facebook.fbthrift</groupId>
      <artifactId>runtime</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.facebook.fbthrift</groupId>
      <artifactId>android-lite</artifactId>
      <version>${fbthrift.java.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.google.guava</groupId>
      <artifactId>guava</artifactId>
      <version>33.4.8-jre</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>it.unimi.dsi</groupId>
      <artifactId>fastutil</artifactId>
      <version>8.5.16</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest</artifactId>
      <version>${hamcrest.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>prepare-generated-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/generated-test-sources/legacy"/>
                <mkdir dir="${project.build.directory}/generated-test-sources/modern"/>
                <mkdir dir="${project.build.directory}/generated-test-sources/android"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>generate-legacy-test-structures</id>
            <phase>generate-test-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>javadeprecated</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-test-sources/legacy</argument>
                <argument>${project.basedir}/src/resources/testing_data_structures.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-legacy-debug-protocol-test</id>
            <phase>generate-test-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>javadeprecated</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-test-sources/legacy</argument>
                <argument>${fbthrift.source.root}/thrift/test/DebugProtoTest.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-legacy-union-test</id>
            <phase>generate-test-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>javadeprecated</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-test-sources/legacy</argument>
                <argument>${fbthrift.source.root}/thrift/test/UnionTest.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-modern-test-structures</id>
            <phase>generate-test-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>java</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-test-sources/modern</argument>
                <argument>${project.basedir}/src/resources/testing_data_structures.thrift</argument>
              </arguments>
            </configuration>
          </execution>
          <execution>
            <id>generate-android-test-structures</id>
            <phase>generate-test-sources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <executable>${fbthrift.compiler}</executable>
              <arguments>
                <argument>-I</argument><argument>${fbthrift.source.root}</argument>
                <argument>--gen</argument><argument>android_lite</argument>
                <argument>-o</argument><argument>${project.build.directory}/generated-test-sources/android</argument>
                <argument>${project.basedir}/src/resources/testing_data_structures.thrift</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>add-generated-test-sources</id>
            <phase>generate-test-sources</phase>
            <goals><goal>add-test-source</goal></goals>
            <configuration>
              <sources>
                <source>${project.basedir}/../java/runtime/src/test/java/org/apache/thrift</source>
                <source>${project.build.directory}/generated-test-sources/legacy/gen-javadeprecated</source>
                <source>${project.build.directory}/generated-test-sources/modern/gen-java</source>
                <source>${project.build.directory}/generated-test-sources/android/gen-android</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
